<Window x:Class="WpfSistemaPOS.Articulos.ModificarArticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modificar Artículo" Height="450" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="ID Compuesto:"/>
            <TextBox x:Name="txtIdCompuesto" IsReadOnly="True"/>

            <TextBlock Text="Descripción:"/>
            <TextBox x:Name="txtDescripcion"/>

            <TextBlock Text="Precio:"/>
            <TextBox x:Name="txtPrecio"/>

            <TextBlock Text="Existencia:"/>
            <TextBox x:Name="txtExistencia"/>

            <TextBlock Text="Categoría:"/>
            <TextBox x:Name="txtCategoria"/>

            <Button Content="Guardar Cambios" Margin="0,20,0,0" Click="GuardarCambios_Click"/>
        </StackPanel>
    </Grid>
</Window>
