<Window x:Class="WpfSistemaPOS.Articulos.EliminarArticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eliminar Artículo" Height="450" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="ID Compuesto:"/>
            <TextBox x:Name="txtIdCompuestoEliminar"/>

            <Button Content="Eliminar" Margin="0,20,0,0" Click="Eliminar_Click"/>
        </StackPanel>
    </Grid>
</Window>
